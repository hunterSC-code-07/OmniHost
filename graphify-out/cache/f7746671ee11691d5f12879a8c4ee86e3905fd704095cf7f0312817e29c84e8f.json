{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"minecraftprocessmanager","label":"MinecraftProcessManager.ts","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L1"}]},{"id":"minecraftprocessmanager_minecraftprocessmanager","label":"MinecraftProcessManager","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L11-L388","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L11"}],"snippet":"export class MinecraftProcessManager {\n  serverId: number;\n  serverDir: string;\n  process: ChildProcess | null = null;\n  playerManager: MinecraftPlayerManager;\n  autoStopTimer: NodeJS.Timeout | null = null;\n  statsTimer: NodeJS.Timeout | null = null;\n  omnihostMeta: any = {}; \n  javaPid: number | null = null; \n  isFullyStarted: boolean = false; \n  logHistory: string[] = [];\n\n  constructor(serverId: number) {\n    this.serverId = serverId;\n    this.serverDir = join(app.getPath('userData'), 'servers', serverId.toString());\n    this.playerManager = new MinecraftPlayerManager(serverId, this.serverDir);\n  }\n\n  sendLog(msg: string) {\n    console.log(msg); // Guaranteed VS Code output!\n    this.logHistory.push(msg);\n    if (this.logHistory.length > 2000) this.logHistory.shift();\n    BrowserWindow.getAllWindows().forEach(win => {\n      if (!win.isDestroyed()) win.webContents.send('console-log', { id: this.serverId, msg });\n    });"},{"id":"minecraftprocessmanager_minecraftprocessmanager_constructor","label":".constructor()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L23-L27","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L23"}],"snippet":"constructor(serverId: number) {\n    this.serverId = serverId;\n    this.serverDir = join(app.getPath('userData'), 'servers', serverId.toString());\n    this.playerManager = new MinecraftPlayerManager(serverId, this.serverDir);\n  }"},{"id":"minecraftprocessmanager_minecraftprocessmanager_sendlog","label":".sendLog()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L29-L36","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L29"}],"snippet":"sendLog(msg: string) {\n    console.log(msg); // Guaranteed VS Code output!\n    this.logHistory.push(msg);\n    if (this.logHistory.length > 2000) this.logHistory.shift();\n    BrowserWindow.getAllWindows().forEach(win => {\n      if (!win.isDestroyed()) win.webContents.send('console-log', { id: this.serverId, msg });\n    });\n  }"},{"id":"minecraftprocessmanager_minecraftprocessmanager_sendcommand","label":".sendCommand()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L38-L45","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L38"}],"snippet":"sendCommand(cmd: string) {\n    if (this.process && this.process.stdin) {\n      this.process.stdin.write(cmd + '\\n');\n      this.sendLog(`> ${cmd}`); \n    } else {\n      this.sendLog(`[System] Cannot send command: Server is offline.`);\n    }\n  }"},{"id":"minecraftprocessmanager_minecraftprocessmanager_getactualpid","label":".getActualPid()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L47-L101","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L47"}],"snippet":"private getActualPid(): Promise<number> {\n    return new Promise((resolve) => {\n      const proc = this.process;\n      if (!proc || !proc.pid) return resolve(0);\n      if (this.javaPid) return resolve(this.javaPid);\n      if (process.platform !== 'win32') return resolve(proc.pid);\n\n      const { spawn } = require('child_process');\n      const ps = spawn('powershell', ['-NoProfile', '-Command', '-']);\n      \n      let out = '';\n      ps.stdout.on('data', (data: any) => out += data.toString());\n      \n      ps.on('close', () => {\n        const pid = parseInt(out.trim());\n        if (!isNaN(pid) && pid > 0) {\n          this.javaPid = pid;\n          resolve(pid);\n        } else {\n          resolve(proc.pid!);\n        }\n      });\n\n      const script = `\n        $all = Get-CimInstance Win32_Process | Select-Object ProcessId, ParentProcessId, Name"},{"id":"minecraftprocessmanager_minecraftprocessmanager_parserunbat","label":".parseRunBat()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L115-L160","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L115"}],"snippet":"private parseRunBat(batPath: string): string[] | null {\n    try {\n      const content = fs.readFileSync(batPath, 'utf-8');\n      const lines = content.split(/\\r?\\n/);\n\n      // Forge run.bat has TWO java commands:\n      //   1) java -jar forge-...-shim.jar --onlyCheckJava  (version check, exits immediately)\n      //   2) java @user_jvm_args.txt @libraries/.../win_args.txt %*  (actual server)\n      // We want the LAST java command, which is always the actual server launch.\n      let lastJavaArgs: string[] | null = null;\n\n      for (const rawLine of lines) {\n        const line = rawLine.trim();\n\n        // Skip non-Java lines (echo, set, rem, pause, empty, labels, conditionals, etc.)\n        if (!line || line.startsWith('@echo') || line.startsWith('REM') || line.startsWith('rem') ||\n            line.startsWith('set ') || line.startsWith('SET ') || line === 'pause' || line === 'PAUSE' ||\n            line.startsWith('::') || line.startsWith('if ') || line.startsWith('IF ') ||\n            line.startsWith(':') || line.startsWith('echo') || line.startsWith('goto')) {\n          continue;\n        }\n\n        // Look for the java launch command\n        // Matches: java ..., \"java\" ..., %JAVA_HOME%\\bin\\java ..., \"path\\to\\java.exe\" ...\n        const javaMatch = line.match(/^(?:@\\s*)?(?:\"[^\"]*[/\\\\])?(?:java(?:w)?(?:\\.exe)?)\"?\\s+(.*)/i);"},{"id":"minecraftprocessmanager_minecraftprocessmanager_start","label":".start()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L162-L331","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L162"}],"snippet":"async start() {\n    await MinecraftConfigManager.init(this.serverDir);\n    this.playerManager.clearOnlinePlayers(); \n    this.logHistory = [];\n    this.isFullyStarted = false;\n    this.playerManager.sendPlayerUpdate();\n    \n    this.sendLog(`[System] Starting Server ${this.serverId}...`);\n\n    const metaPath = join(this.serverDir, 'omnihost.json');\n    let version = '1.20.4';\n    if (fs.existsSync(metaPath)) {\n      try {\n        const meta = JSON.parse(fs.readFileSync(metaPath, 'utf-8'));\n        this.omnihostMeta = meta;\n        if (meta.version) version = meta.version;\n      } catch(e) {}\n    }\n\n    let javaRequired: 8 | 16 | 17 | 21 | 25 = 17;\n    const coerced = semver.coerce(version);\n    if (coerced) {\n      if (semver.lt(coerced, '1.17.0')) javaRequired = 8;\n      else if (semver.lt(coerced, '1.18.0')) javaRequired = 16;\n      else if (semver.lt(coerced, '1.20.5')) javaRequired = 17;"},{"id":"minecraftprocessmanager_minecraftprocessmanager_stop","label":".stop()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L333-L387","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L333"}],"snippet":"async stop(): Promise<void> {\n    return new Promise(async (resolve) => {\n      if (!this.process) {\n        resolve();\n        return;\n      }\n      \n      this.sendLog(`[System] Stopping Server ${this.serverId}...`);\n      this.process.stdin?.write('stop\\n');\n      \n      const p = this.process;\n      this.process = null;\n      if (this.autoStopTimer) clearTimeout(this.autoStopTimer);\n      if (this.statsTimer) clearInterval(this.statsTimer);\n      this.autoStopTimer = null;\n      this.statsTimer = null;\n\n      // Update stats for all players before clearing them\n      await this.playerManager.handleServerStop();\n\n      let isResolved = false;\n\n      p.on('exit', () => {\n         if (!isResolved) {\n             isResolved = true;"}],"edges":[{"source":"minecraftprocessmanager","target":"child_process","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/Min