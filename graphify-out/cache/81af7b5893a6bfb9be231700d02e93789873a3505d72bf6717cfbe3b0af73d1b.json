        }
      ],
      "snippet": "async start() {\n    await DayzConfigManager.ensureDefaultConfig(this.serverDir);\n\n    const exePath = join(this.serverDir, 'DayZServer_x64.exe');\n    if (!fs.existsSync(exePath)) {\n      this.sendLog(`[System] DayZ Server executable not found at ${exePath}. Did you finish the SteamCMD download?`);\n      return;\n    }\n\n    this.sendLog('[System] Starting DayZ Server...');\n\n    const args = [\n      '-config=serverDZ.cfg',\n      '-port=2302',\n      '-profiles=Profiles',\n      '-BEpath=BattlEye',\n      '-dologs',\n      '-adminlog',\n      '-netlog',\n      '-freezecheck'\n    ];\n\n    // Load mods\n    try {\n      const sortedMods = DayzModGraph.resolveMods(this.serverDir);"
    },
    {
      "id": "dayzprocessmanager_dayzprocessmanager_stop",
      "label": ".stop()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/main/dayz/DayzProcessManager.ts",
      "source_location": "L116-L132",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/main/dayz/DayzProcessManager.ts",
          "source_location": "L116"
        }
      ],
      "snippet": "stop() {\n    if (this.process) {\n      this.sendLog('[System] Stopping DayZ Server...');\n      if (this.process.pid) {\n        if (process.platform === 'win32') {\n          spawn('taskkill', ['/pid', this.process.pid.toString(), '/f', '/t']);\n        } else {\n          this.process.kill();\n        }\n      }\n      this.process = null;\n      this.logParser?.cleanup();\n    }\n    \n    this.onlinePlayers = [];\n    this.sendPlayerUpdate();\n  }"
    }
  ],
