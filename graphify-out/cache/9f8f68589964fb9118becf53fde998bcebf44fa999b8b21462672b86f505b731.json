teRebuildLoadOrder } = useDayzModOperations(\n    activeServerId, \n    mods, \n    loadInstalledMods, \n    setLoading, \n    {\n      onMissingDependencies: (depNames, depDetails) => setModalState({ type: 'MISSING_DEPS', data: { depNames, depDetails } }),\n      onUninstallSingle: (modId, modName) => setModalState({ type: 'UNINSTALL_SINGLE', data: { modId, modName } }),\n      onUninstallAll: () => setModalState({ type: 'UNINSTALL_ALL' }),\n      onRebuildConfirm: () => setModalState({ type: 'REBUILD_CONFIRM' }),\n      onRebuildSuccess: () => setModalState({ type: 'REBUILD_SUCCESS' }),\n      onError: (message) => setModalState({ type: 'INFO', data: { message } })\n    }\n  );","node_kind":"component"},{"id":"dayzinstalledmodstab_dayzinstalledmodstab_openworkshoppage","label":"openWorkshopPage()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzInstalledModsTab.tsx","source_location":"L37-L41","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzInstalledModsTab.tsx","source_location":"L37"}],"snippet":"openWorkshopPage = (id: string) => {\n    if (/^\\d+$/.test(id)) {\n      window.open(`https://steamcommunity.com/sharedfiles/filedetails/?id=${id}`, '_blank');\n    }\n  }"}],"edges":[{"source":"dayzinstalledmodstab","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzInstalledModsTab.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzInstalledModsTab.tsx","source_location":"L1"}],"weight":1},{"source":"dayzinstalledmodstab","target":"overlayscrollbars_react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniH