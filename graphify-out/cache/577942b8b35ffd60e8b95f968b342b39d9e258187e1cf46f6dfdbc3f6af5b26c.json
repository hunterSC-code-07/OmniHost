{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"usedayzmodoperations","label":"useDayzModOperations.ts","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L1"}]},{"id":"usedayzmodoperations_dayzmodoperationcallbacks","label":"DayzModOperationCallbacks","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L3-L10","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L3"}],"snippet":"export interface DayzModOperationCallbacks {\n  onMissingDependencies: (depNames: string, depDetails: any[]) => void;\n  onUninstallSingle: (modId: string, modName: string) => void;\n  onUninstallAll: () => void;\n  onRebuildConfirm: () => void;\n  onRebuildSuccess: () => void;\n  onError: (message: string) => void;\n}"},{"id":"usedayzmodoperations_usedayzmodoperations","label":"useDayzModOperations()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L12-L122","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L12"}],"snippet":"useDayzModOperations = (\n  activeServerId: number | null,\n  mods: any[],\n  loadInstalledMods: () => Promise<void>,\n  setLoading: React.Dispatch<React.SetStateAction<boolean>>,\n  callbacks: DayzModOperationCallbacks\n) => {\n  const [isRebuilding, setIsRebuilding] = useState(false);\n\n  const handleToggleMap = async (folderName: string, currentIsMap: boolean) => {\n    if (!activeServerId) return;\n    await window.api.dayz.toggleMapMod(activeServerId, folderName, !currentIsMap);\n    loadInstalledMods();\n  };\n\n  const handleToggleModStatus = async (mod: any) => {\n    if (!activeServerId) return;\n    const isEnabling = mod.isDisabled;\n    await window.api.dayz.toggleModStatus(activeServerId, mod.folderName, !isEnabling);\n\n    if (isEnabling && mod.id && /^\\d+$/.test(mod.id)) {\n      try {\n        const dependencies = await window.api.steam.getModDependencies(mod.id);\n        if (dependencies && dependencies.length > 0) {\n          const installedDeps = mods.filter(m => dependencies.includes(m.id));"},{"id":"usedayzmodoperations_usedayzmodoperations_handletogglemap","label":"handleToggleMap()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L21-L25","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L21"}],"snippet":"handleToggleMap = async (folderName: string, currentIsMap: boolean) => {\n    if (!activeServerId) return;\n    await window.api.dayz.toggleMapMod(activeServerId, folderName, !currentIsMap);\n    loadInstalledMods();\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_handletogglemodstatus","label":"handleToggleModStatus()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L27-L60","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L27"}],"snippet":"handleToggleModStatus = async (mod: any) => {\n    if (!activeServerId) return;\n    const isEnabling = mod.isDisabled;\n    await window.api.dayz.toggleModStatus(activeServerId, mod.folderName, !isEnabling);\n\n    if (isEnabling && mod.id && /^\\d+$/.test(mod.id)) {\n      try {\n        const dependencies = await window.api.steam.getModDependencies(mod.id);\n        if (dependencies && dependencies.length > 0) {\n          const installedDeps = mods.filter(m => dependencies.includes(m.id));\n          const missingDepIds = dependencies.filter(depId => !mods.find(m => m.id === depId));\n\n          for (const installedDep of installedDeps) {\n            if (installedDep.isDisabled) {\n              await window.api.dayz.toggleModStatus(activeServerId, installedDep.folderName, false);\n            }\n          }\n\n          if (missingDepIds.length > 0) {\n            const depDetails = await window.api.steam.getWorkshopItemDetails(missingDepIds);\n            if (depDetails && depDetails.length > 0) {\n              const depNames = depDetails.map((d: any) => d.title).join(', ');\n              callbacks.onMissingDependencies(depNames, depDetails);\n              return;\n            }"},{"id":"usedayzmodoperations_usedayzmodoperations_handleuninstall","label":"handleUninstall()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L62-L65","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L62"}],"snippet":"handleUninstall = (modId: string, modName: string) => {\n    if (!activeServerId) return;\n    callbacks.onUninstallSingle(modId, modName);\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_executeuninstall","label":"executeUninstall()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L67-L74","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L67"}],"snippet":"executeUninstall = async (modId: string) => {\n    try {\n      await window.api.dayz.uninstallMod(activeServerId!, modId);\n      await loadInstalledMods();\n    } catch (e: any) {\n      callbacks.onError(`Failed to uninstall mod: ${e.message}`);\n    }\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_handleuninstallall","label":"handleUninstallAll()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L76-L79","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L76"}],"snippet":"handleUninstallAll = () => {\n    if (mods.length === 0 || !activeServerId) return;\n    callbacks.onUninstallAll();\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_executeuninstallall","label":"executeUninstallAll()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L81-L93","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L81"}],"snippet":"executeUninstallAll = async () => {\n    setLoading(true);\n    try {\n      for (const mod of mods) {\n        await window.api.dayz.uninstallMod(activeServerId!, mod.folderName || mod.id);\n      }\n      await loadInstalledMods();\n    } catch (e: any) {\n      callbacks.onError(`Failed to uninstall some mods: ${e.message}`);\n      await loadInstalledMods();\n    }\n    setLoading(false);\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_handlerebuildloadorder","label":"handleRebuildLoadOrder()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L95-L98","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L95"}],"snippet":"handleRebuildLoadOrder = () => {\n    if (!activeServerId) return;\n    callbacks.onRebuildConfirm();\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_executerebuildloadorder","label":"executeRebuildLoadOrder()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L100-L109","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L100"}],"snippet":"executeRebuildLoadOrder = async () => {\n    setIsRebuilding(true);\n    try {\n      await window.api.dayz.rebuildModDependencies(activeServerId!);\n      callbacks.onRebuildSuccess();\n    } catch (e: any) {\n      callbacks.onError('Failed to rebuild load order: ' + e.message);\n    }\n    setIsRebuilding(false);\n  }"}],"edges":[{"source":"usedayzmodoperations","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L1"}],"weight":1},{"source":"usedayzmodoperations","target":"usedayzmodoperations_dayzmodoperationcallbacks","relation":"contains","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L3"}],"weight":1},{"source":"usedayzmodoperations","target":"usedayzmodoperations_usedayzmodoperations","relation":"contains","confidence":"EXTR