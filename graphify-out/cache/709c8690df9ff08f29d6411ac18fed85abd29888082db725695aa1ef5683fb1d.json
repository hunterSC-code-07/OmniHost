          "source_location": "L29"
        }
      ],
      "snippet": "loadPlayers = async (id: number, type: string) => {\n    if (type === 'live') {\n      setPlayerData([]);\n      return;\n    }\n    if (type === 'history') {\n      // @ts-ignore\n      const stats = await window.api.getPlayerStats(id);\n      setPlayerData(stats ? Object.values(stats) : []);\n    } else {\n      // @ts-ignore\n      const data = await window.api.readJson(id, type);\n      setPlayerData(data || []);\n    }\n  }"
    },
    {
      "id": "useminecraftplayers_useminecraftplayers_handleaddplayer",
      "label": "handleAddPlayer()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useMinecraftPlayers.ts",
