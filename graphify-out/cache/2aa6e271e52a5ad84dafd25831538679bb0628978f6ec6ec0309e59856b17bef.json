      "snippet": "stripBBCode = (text: string) => {\n    if (!text) return '';\n    return text.replace(/\\[\\/?(b|i|u|s|h\\d|url|img|list|code|quote|spoiler|\\*|hr)(?:=[^\\]]+)?\\]/gi, '');\n  }"
