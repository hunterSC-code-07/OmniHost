      ],
      "snippet": "export function ListViewIcon({ isActive, className }: ListViewIconProps) {\n  return (\n    <motion.span\n      className={`inline-flex h-4 w-4 flex-col items-center justify-center gap-[3px] ${className ?? \"\"}`}\n      aria-hidden=\"true\"\n    >\n      {[0, 1, 2].map((i) => (\n        <motion.span\n          key={i}\n          className=\"h-[2px] w-3 rounded-full bg-current\"\n          animate={\n            isActive\n              ? { y: LINE_TRAVEL[i], opacity: [0.55, 1, 1] }\n              : { y: 0, opacity: 0.9 }\n          }\n          transition={{\n            duration: 0.36,\n            delay: i === 0 ? 0 : i * LINE_DELAY_STEP,\n            ease: \"easeOut\",\n          }}\n        />\n      ))}\n    </motion.span>\n  );\n}",
      "node_kind": "function",
      "framework": "nextjs",
      "framework_role": "next_client_component",
      "runtime_boundary": "client"
    }
