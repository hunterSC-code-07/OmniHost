{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"sevendaystodieprocessmanager","label":"SevenDaysToDieProcessManager.ts","file_type":"code","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L1"}]},{"id":"sevendaystodieprocessmanager_sevendaystodieprocessmanager","label":"SevenDaysToDieProcessManager","file_type":"code","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L6-L121","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L6"}],"snippet":"export class SevenDaysToDieProcessManager {\n  serverId: number;\n  serverDir: string;\n  process: ChildProcess | null = null;\n  onlinePlayers: string[] = [];\n\n  constructor(serverId: number) {\n    this.serverId = serverId;\n    this.serverDir = join(app.getPath('userData'), 'servers', serverId.toString());\n  }\n\n  sendLog(msg: string) {\n    console.log(msg); // Guaranteed VS Code output\n    BrowserWindow.getAllWindows().forEach(win => {\n      if (!win.isDestroyed()) win.webContents.send('console-log', { id: this.serverId, msg });\n    });\n  }\n\n  sendPlayerUpdate() {\n    BrowserWindow.getAllWindows().forEach(win => {\n      if (!win.isDestroyed()) win.webContents.send('online-players', { id: this.serverId, players: this.onlinePlayers });\n    });\n  }\n\n  sendCommand(cmd: string) {"},{"id":"sevendaystodieprocessmanager_sevendaystodieprocessmanager_constructor","label":".constructor()","file_type":"code","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L12-L15","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L12"}],"snippet":"constructor(serverId: number) {\n    this.serverId = serverId;\n    this.serverDir = join(app.getPath('userData'), 'servers', serverId.toString());\n  }"},{"id":"sevendaystodieprocessmanager_sevendaystodieprocessmanager_sendlog","label":".sendLog()","file_type":"code","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L17-L22","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L17"}],"snippet":"sendLog(msg: string) {\n    console.log(msg); // Guaranteed VS Code output\n    BrowserWindow.getAllWindows().forEach(win => {\n      if (!win.isDestroyed()) win.webContents.send('console-log', { id: this.serverId, msg });\n    });\n  }"},{"id":"sevendaystodieprocessmanager_sevendaystodieprocessmanager_sendplayerupdate","label":".sendPlayerUpdate()","file_type":"code","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L24-L28","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L24"}],"snippet":"sendPlayerUpdate() {\n    BrowserWindow.getAllWindows().forEach(win => {\n      if (!win.isDestroyed()) win.webContents.send('online-players', { id: this.serverId, players: this.onlinePlayers });\n    });\n  }"},{"id":"sevendaystodieprocessmanager_sevendaystodieprocessmanager_sendcommand","label":".sendCommand()","file_type":"code","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L30-L36","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L30"}],"snippet":"sendCommand(cmd: string) {\n    if (this.process && this.process.stdin) {\n      this.process.stdin.write(cmd + '\\n');\n    } else {\n      this.sendLog(`[System] Process not running, cannot send command: ${cmd}`);\n    }\n  }"},{"id":"sevendaystodieprocessmanager_sevendaystodieprocessmanager_start","label":".start()","file_type":"code","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L38-L80","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L38"}],"snippet":"async start() {\n    const exePath = join(this.serverDir, '7DaysToDieServer.exe');\n    if (!fs.existsSync(exePath)) {\n      this.sendLog(`[System] 7 Days to Die Server executable not found at ${exePath}. Did you finish the SteamCMD download?`);\n      return;\n    }\n\n    this.sendLog('[System] Starting 7 Days to Die Server...');\n\n    // Usually 7dtd servers are started with arguments: -quit -batchmode -nographics -dedicated\n    const args = [\n      '-quit',\n      '-batchmode',\n      '-nographics',\n      '-dedicated'\n    ];\n\n    this.process = spawn(`\"${exePath}\"`, args, { cwd: this.serverDir, shell: true });\n\n    this.process.stdout?.on('data', (data) => {\n      const text = data.toString();\n      const lines = text.trim().split('\\n');\n      for (const line of lines) {\n        this.sendLog(`[7DTD] ${line.trim()}`);\n        this.parseLogLine(line.trim());"},{"id":"sevendaystodieprocessmanager_sevendaystodieprocessmanager_parselogline","label":".parseLogLine()","file_type":"code","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L82-L101","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L82"}],"snippet":"parseLogLine(line: string) {\n    // Basic example of player parsing if it exists in stdout logs\n    // e.g. \"Player connected, entityid=171 name=Soprano\"\n    const connectedMatch = line.match(/Player connected, entityid=\\d+ name=(.+)/);\n    if (connectedMatch) {\n      const playerName = connectedMatch[1].trim();\n      if (!this.onlinePlayers.includes(playerName)) {\n        this.onlinePlayers.push(playerName);\n        this.sendPlayerUpdate();\n      }\n    }\n\n    // e.g. \"Player disconnected: name=Soprano\"\n    const disconnectedMatch = line.match(/Player disconnected: name=(.+)/);\n    if (disconnectedMatch) {\n      const playerName = disconnectedMatch[1].trim();\n      this.onlinePlayers = this.onlinePlayers.filter(p => p !== playerName);\n      this.sendPlayerUpdate();\n    }\n  }"},{"id":"sevendaystodieprocessmanager_sevendaystodieprocessmanager_stop","label":".stop()","file_type":"code","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L103-L120","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/7dtd/SevenDaysToDieProcessManager.ts","source_location":"L103"}],"snippet":"stop() {\n    if (this.process) {\n      this.sendLog('[System] Stopping 7 Days to Die Server...');\n      // 7dtd server accepts 'shutdown' command via telnet, but via stdin if it works we can try.\n      // Alternatively, we can force kill.\n      if (this.process.pid) {\n        if (process.platform === 'win32') {\n          spawn('taskkill', ['/pid', this.process.pid.toString(), '/f', '/t']);\n        } else {\n          this.process.kill();\n        }\n      }\n      this.process = null;\n    }\n    \n    this.onlinePlayers = [];\n    this.sendPlayerUpdate();\n  }"}],"edges":[{"source":"sevendaystodieprocessmanager","target":"child_process","relation":"imports_from","conf