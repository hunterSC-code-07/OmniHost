{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"usedayzmodoperations","label":"useDayzModOperations.ts","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L1"}]},{"id":"usedayzmodoperations_usedayzmodoperations","label":"useDayzModOperations()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L3-L116","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L3"}],"snippet":"useDayzModOperations = (\n  activeServerId: number | null,\n  mods: any[],\n  loadInstalledMods: () => Promise<void>,\n  setModalState: React.Dispatch<React.SetStateAction<any>>,\n  setLoading: React.Dispatch<React.SetStateAction<boolean>>\n) => {\n  const [isRebuilding, setIsRebuilding] = useState(false);\n\n  const handleToggleMap = async (folderName: string, currentIsMap: boolean) => {\n    if (!activeServerId) return;\n    await window.api.dayz.toggleMapMod(activeServerId, folderName, !currentIsMap);\n    loadInstalledMods();\n  };\n\n  const handleToggleModStatus = async (mod: any) => {\n    if (!activeServerId) return;\n    const isEnabling = mod.isDisabled;\n    await window.api.dayz.toggleModStatus(activeServerId, mod.folderName, !isEnabling);\n\n    if (isEnabling && mod.id && /^\\d+$/.test(mod.id)) {\n      try {\n        const dependencies = await window.api.steam.getModDependencies(mod.id);\n        if (dependencies && dependencies.length > 0) {\n          const installedDeps = mods.filter(m => dependencies.includes(m.id));"},{"id":"usedayzmodoperations_usedayzmodoperations_handletogglemap","label":"handleToggleMap()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L12-L16","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L12"}],"snippet":"handleToggleMap = async (folderName: string, currentIsMap: boolean) => {\n    if (!activeServerId) return;\n    await window.api.dayz.toggleMapMod(activeServerId, folderName, !currentIsMap);\n    loadInstalledMods();\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_handletogglemodstatus","label":"handleToggleModStatus()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L18-L51","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L18"}],"snippet":"handleToggleModStatus = async (mod: any) => {\n    if (!activeServerId) return;\n    const isEnabling = mod.isDisabled;\n    await window.api.dayz.toggleModStatus(activeServerId, mod.folderName, !isEnabling);\n\n    if (isEnabling && mod.id && /^\\d+$/.test(mod.id)) {\n      try {\n        const dependencies = await window.api.steam.getModDependencies(mod.id);\n        if (dependencies && dependencies.length > 0) {\n          const installedDeps = mods.filter(m => dependencies.includes(m.id));\n          const missingDepIds = dependencies.filter(depId => !mods.find(m => m.id === depId));\n\n          for (const installedDep of installedDeps) {\n            if (installedDep.isDisabled) {\n              await window.api.dayz.toggleModStatus(activeServerId, installedDep.folderName, false);\n            }\n          }\n\n          if (missingDepIds.length > 0) {\n            const depDetails = await window.api.steam.getWorkshopItemDetails(missingDepIds);\n            if (depDetails && depDetails.length > 0) {\n              const depNames = depDetails.map((d: any) => d.title).join(', ');\n              setModalState({ type: 'MISSING_DEPS', data: { depNames, depDetails } });\n              return;\n            }"},{"id":"usedayzmodoperations_usedayzmodoperations_handleuninstall","label":"handleUninstall()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L53-L56","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L53"}],"snippet":"handleUninstall = (modId: string, modName: string) => {\n    if (!activeServerId) return;\n    setModalState({ type: 'UNINSTALL_SINGLE', data: { modId, modName } });\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_executeuninstall","label":"executeUninstall()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L58-L66","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L58"}],"snippet":"executeUninstall = async (modId: string) => {\n    try {\n      await window.api.dayz.uninstallMod(activeServerId!, modId);\n      await loadInstalledMods();\n      setModalState({ type: null });\n    } catch (e: any) {\n      setModalState({ type: 'INFO', data: { message: `Failed to uninstall mod: ${e.message}` } });\n    }\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_handleuninstallall","label":"handleUninstallAll()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L68-L71","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L68"}],"snippet":"handleUninstallAll = () => {\n    if (mods.length === 0 || !activeServerId) return;\n    setModalState({ type: 'UNINSTALL_ALL' });\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_executeuninstallall","label":"executeUninstallAll()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L73-L86","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L73"}],"snippet":"executeUninstallAll = async () => {\n    setLoading(true);\n    setModalState({ type: null });\n    try {\n      for (const mod of mods) {\n        await window.api.dayz.uninstallMod(activeServerId!, mod.folderName || mod.id);\n      }\n      await loadInstalledMods();\n    } catch (e: any) {\n      setModalState({ type: 'INFO', data: { message: `Failed to uninstall some mods: ${e.message}` } });\n      await loadInstalledMods();\n    }\n    setLoading(false);\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_handlerebuildloadorder","label":"handleRebuildLoadOrder()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L88-L91","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L88"}],"snippet":"handleRebuildLoadOrder = () => {\n    if (!activeServerId) return;\n    setModalState({ type: 'REBUILD_CONFIRM' });\n  }"},{"id":"usedayzmodoperations_usedayzmodoperations_executerebuildloadorder","label":"executeRebuildLoadOrder()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzModOperations.ts","source_location":"L93-L103","layer":"base","provenance":[{"capability_id":"builtin:extract:typescri