forgeFile()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L55-L65","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L55"}],"snippet":"static async getCurseforgeFile(modId: number, fileId: number) {\n    try {\n      const res = await axios.get(`https://api.curseforge.com/v1/mods/${modId}/files/${fileId}`, {\n        headers: { 'x-api-key': process.env.CURSEFORGE_API_KEY || '' }\n      })\n      return res.data.data\n    } catch (e: any) {\n      console.error('Error getting Curseforge file:', e.message)\n      return null\n    }\n  }"},{"id":"minecraftmodmanager_minecraftmodmanager_installcurseforgemod","label":".installCurseforgeMod()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L67-L89","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L67"}],"snippet":"static async installCurseforgeMod(event: any, id: number, downloadUrl: string, fileName: string, classId: number = 6) {\n    try {\n      const serverDir = join(app.getPath('userData'), 'servers', id.toString())\n      // 6 is Mods, 12 is Resource Packs, 17 is Worlds\n      const folderName = classId === 12 ? 'resourcepacks' : classId === 17 ? 'saves' : 'mods'\n      const targetDir = join(serverDir, folderName)\n      \n      await fsPromises.mkdir(targetDir, { recursive: true })\n      const targetPath = join(targetDir, fileName)\n\n      const cachedFile = await CacheManager.getOrDownload('mods', downloadUrl, fileName, (progress) => {\n        if (event && event.sender) {\n          event.sender.send(`download-progress-${id}`, progress, `Downloading ${fileName}...`)\n        }\n      })\n      \n      await fsPromises.copyFile(cachedFile, targetPath)\n      return true\n    } catch (e: any) {\n      console.error('Failed to install mod:', e.message)\n      throw new Error(e.message)\n    }\n  }"},{"id":"minecraftmodmanager_minecraftmodmanager_installcurseforgemodpack","label":".installCurseforgeModpack()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L91-L93","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L91"}],"snippet":"static async installCurseforgeModpack(_event: any, _id: number, _modId: number, _version: string) {\n    throw new Error('Modpack installation is not yet fully implemented.')\n  }"},{"id":"minecraftmodmanager_minecraftmodmanager_getinstalledmods","label":".getInstalledMods()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L95-L114","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L95"}],"snippet":"static async getInstalledMods(id: number) {\n    try {\n      const serverDir = join(app.getPath('userData'), 'servers', id.toString())\n      const modsDir = join(serverDir, 'mods')\n      \n      try {\n        await fsPromises.access(modsDir)\n      } catch {\n        return [] \n      }\n      \n      const files = await fsPromises.readdir(modsDir, { withFileTypes: true })\n      return files\n        .filter(f => f.isFile() && f.name.endsWith('.jar'))\n        .map(f => ({ name: f.name }))\n    } catch (e: any) {\n      console.error('Error getting installed mods:', e.message)\n      return []\n    }\n  }"},{"id":"minecraftmodmanager_minecraftmodmanager_deletemod","label":".deleteMod()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L116-L127","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L116"}],"snippet":"static async deleteMod(id: number, fileName: string) {\n    try {\n      const serverDir = join(app.getPath('userData'), 'servers', id.toString())\n      const modPath = join(serverDir, 'mods', fileName)\n      \n      await fsPromises.unlink(modPath)\n      return true\n    } catch (e: any) {\n      console.error('Error deleting mod:', e.message)\n      throw new Error(e.message)\n    }\n  }"},{"id":"minecraftmodmanager_minecraftmodmanager_searchmodpacks","label":".searchModpacks()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L129-L131","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L129"}],"snippet":"static async searchModpacks(query: string, version: string, modloader: string) {\n    return this.searchCurseforgeMods(query, modloader, version, 0, 4471, 2)\n  }"},{"id":"minecraftmodmanager_minecraftmodmanager_getmodpackdetails","label":".getModpackDetails()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L133-L135","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts","source_location":"L133"}],"snippet":"static async getModpackDetails(modId: string) {\n    return this.getCurseforgeMod(parseInt(modId))\n  }"}],"edges":[{"source":"minecraftmodmanager","target":"electron","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftModManager.ts