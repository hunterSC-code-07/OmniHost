      "snippet": "stopListening() {\n    if (this.server) {\n      try {\n        this.server.close();\n      } catch (e) {}\n      this.server = null;\n      this.adapter.sendLog(`[WakeProxy] Stopped listening on port ${this.port}.`);\n    }\n  }"
