{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"satisfactoryprocessmanager","label":"SatisfactoryProcessManager.ts","file_type":"code","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L1"}]},{"id":"satisfactoryprocessmanager_satisfactoryprocessmanager","label":"SatisfactoryProcessManager","file_type":"code","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L8-L154","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L8"}],"snippet":"export class SatisfactoryProcessManager {\n  serverId: number;\n  serverDir: string;\n  process: ChildProcess | null = null;\n  onlinePlayers: string[] = [];\n  apiToken: string | null = null;\n  private pollInterval: NodeJS.Timeout | null = null;\n\n  constructor(serverId: number) {\n    this.serverId = serverId;\n    this.serverDir = join(app.getPath('userData'), 'servers', serverId.toString());\n    this.loadToken();\n  }\n\n  loadToken() {\n    try {\n      const cfgPath = join(this.serverDir, 'omnihost-config.json');\n      if (fs.existsSync(cfgPath)) {\n        const data = JSON.parse(fs.readFileSync(cfgPath, 'utf-8'));\n        this.apiToken = data.satisfactoryApiToken || null;\n      }\n    } catch (e) {\n      console.error('Failed to load satisfactory token', e);\n    }\n  }"},{"id":"satisfactoryprocessmanager_satisfactoryprocessmanager_constructor","label":".constructor()","file_type":"code","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L16-L20","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L16"}],"snippet":"constructor(serverId: number) {\n    this.serverId = serverId;\n    this.serverDir = join(app.getPath('userData'), 'servers', serverId.toString());\n    this.loadToken();\n  }"},{"id":"satisfactoryprocessmanager_satisfactoryprocessmanager_loadtoken","label":".loadToken()","file_type":"code","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L22-L32","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L22"}],"snippet":"loadToken() {\n    try {\n      const cfgPath = join(this.serverDir, 'omnihost-config.json');\n      if (fs.existsSync(cfgPath)) {\n        const data = JSON.parse(fs.readFileSync(cfgPath, 'utf-8'));\n        this.apiToken = data.satisfactoryApiToken || null;\n      }\n    } catch (e) {\n      console.error('Failed to load satisfactory token', e);\n    }\n  }"},{"id":"satisfactoryprocessmanager_satisfactoryprocessmanager_sendlog","label":".sendLog()","file_type":"code","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L34-L39","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L34"}],"snippet":"sendLog(msg: string) {\n    console.log(msg); // Guaranteed VS Code output!\n    BrowserWindow.getAllWindows().forEach(win => {\n      if (!win.isDestroyed()) win.webContents.send('console-log', { id: this.serverId, msg });\n    });\n  }"},{"id":"satisfactoryprocessmanager_satisfactoryprocessmanager_sendplayerupdate","label":".sendPlayerUpdate()","file_type":"code","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L41-L45","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L41"}],"snippet":"sendPlayerUpdate() {\n    BrowserWindow.getAllWindows().forEach(win => {\n      if (!win.isDestroyed()) win.webContents.send('online-players', { id: this.serverId, players: this.onlinePlayers });\n    });\n  }"},{"id":"satisfactoryprocessmanager_satisfactoryprocessmanager_sendcommand","label":".sendCommand()","file_type":"code","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L47-L49","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L47"}],"snippet":"sendCommand(cmd: string) {\n    this.sendLog(`[System] Satisfactory commands via console are not natively supported by the standard engine output yet. Command: ${cmd}`);\n  }"},{"id":"satisfactoryprocessmanager_satisfactoryprocessmanager_start","label":".start()","file_type":"code","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L51-L95","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L51"}],"snippet":"async start() {\n    const exePath = join(this.serverDir, 'FactoryServer.exe');\n    if (!fs.existsSync(exePath)) {\n      this.sendLog(`[System] Satisfactory Server executable not found at ${exePath}. Did you finish the SteamCMD download?`);\n      return;\n    }\n\n    this.sendLog('[System] Starting Satisfactory Server...');\n    this.loadToken(); // Refresh token on start\n\n    const args = [\n      '-log',\n      '-unattended'\n    ];\n\n    this.process = spawn(`\"${exePath}\"`, args, { cwd: this.serverDir, shell: true });\n\n    this.process.stdout?.on('data', (data) => {\n      const text = data.toString();\n      fs.appendFileSync(join(app.getAppPath(), '..', '..', 'satisfactory_debug.log'), text);\n      const lines = text.trim().split('\\n');\n      for (const line of lines) {\n        this.sendLog(`[Satisfactory] ${line.trim()}`);\n      }\n    });"},{"id":"satisfactoryprocessmanager_satisfactoryprocessmanager_startpolling","label":".startPolling()","file_type":"code","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L97-L134","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L97"}],"snippet":"startPolling() {\n    if (this.pollInterval) clearInterval(this.pollInterval);\n\n    // Poll every 10 seconds\n    this.pollInterval = setInterval(async () => {\n      if (!this.process || !this.apiToken) return;\n\n      try {\n        const agent = new https.Agent({ rejectUnauthorized: false }); // Bypass self-signed cert\n        const res = await axios.post('https://127.0.0.1:7777/api/v1', {\n          function: 'QueryServerState'\n        }, {\n          httpsAgent: agent,\n          headers: {\n            'Authorization': `Bearer ${this.apiToken}`,\n            'Content-Type': 'application/json'\n          }\n        });\n\n        if (res.status === 200) {\n          const data = res.data;\n          \n          if (data && data.data && data.data.serverGameState) {\n             const numPlayers = data.data.serverGameState.numConnectedPlayers || 0;\n             const newPlayers = Array(numPlayers).fill('Unknown Pioneer');"},{"id":"satisfactoryprocessmanager_satisfactoryprocessmanager_stop","label":".stop()","file_type":"code","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L136-L153","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L136"}],"snippet":"stop() {\n    if (this.pollInterval) clearInterval(this.pollInterval);\n    \n    if (this.process) {\n      this.sendLog('[System] Stopping Satisfactory Server...');\n      if (this.process.pid) {\n        if (process.platform === 'win32') {\n          spawn('taskkill', ['/pid', this.process.pid.toString(), '/f', '/t']);\n        } else {\n          this.process.kill();\n        }\n      }\n      this.process = null;\n    }\n    \n    this.onlinePlayers = [];\n    this.sendPlayerUpdate();\n  }"}],"edges":[{"source":"satisfactoryprocessmanager","target":"child_process","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L1"}],"weight":1},{"source":"satisfactoryprocessmanager","target":"path","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L2","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L2"}],"weight":1},{"source":"satisfactoryprocessmanager","target":"electron","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/main/satisfactory/SatisfactoryProcessManager.ts","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/O