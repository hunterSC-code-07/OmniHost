      "id": "frpadapter_frpadapter_start",
      "label": ".start()",
      "file_type": "code",
      "source_file": "C:/OmniHostWIPDAYZ/OmniHost/src/main/adapters/FrpAdapter.ts",
      "source_location": "L28-L153",
