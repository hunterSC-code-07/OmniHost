        }
      ],
      "snippet": "stop() {\n    if (this.process) {\n      this.sendLog('[FRP Tunnel] Disconnecting...');\n      this.process.kill('SIGKILL');\n      import('child_process').then(cp => cp.exec('taskkill /F /IM frpc.exe'));\n      this.process = null;\n    }\n  }"
    }
