      ],
      "snippet": "updatePendingProgress = (modId: string, progress: number, msg: string) => {\n    setPendingDownloads(prev => {\n      if (!prev[modId]) return prev;\n      return {\n        ...prev,\n        [modId]: { ...prev[modId], progress, msg }\n      };\n    });\n  }"
