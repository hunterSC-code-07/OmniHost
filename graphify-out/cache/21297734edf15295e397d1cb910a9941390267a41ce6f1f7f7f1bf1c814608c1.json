      "snippet": "DayzHub: React.FC = () => {\n  const { activeServerId, setActiveServerId, servers, startServer, stopServer, restartServer, deleteServer } = useServerStore();\n  const currentServer = servers.find(s => s.id === activeServerId);\n  const prevServerRef = useRef(currentServer);\n  if (currentServer) {\n    prevServerRef.current = currentServer;\n  }\n  const activeServer = currentServer || prevServerRef.current;\n  \n  if (!activeServer) return null;\n  const { radminIp } = useUiStore();\n  const { logs, setLogs } = useLogStore();\n  const { onlinePlayers } = usePlayerStore();\n  const { statsHistory } = useStatsStore();\n\n  const handleStart = startServer;\n  const handleStop = stopServer;\n  const handleRestart = restartServer;\n  const handleDelete = deleteServer;\n  const handleTunnel = async () => {}; // This was handled in App.tsx. For now, empty or extract logic if needed.\n\n  const [activeTab, setActiveTab] = useState<'console' | 'options' | 'economy' | 'mods' | 'installed' | 'files'>('console');\n  const [tabDirection, setTabDirection] = useState(0);\n  const [isTabTransitioning, setIsTabTransitioning] = useState(false);\n  const handleTabChange = (newTab: typeof activeTab) => {",
