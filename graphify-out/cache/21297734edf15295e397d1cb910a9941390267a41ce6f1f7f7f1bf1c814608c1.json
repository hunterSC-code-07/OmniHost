      ],
      "snippet": "addPendingDownload = (mod: any) => {\n    setPendingDownloads(prev => ({\n      ...prev,\n      [mod.id || mod.publishedfileid]: { ...mod, progress: 0, msg: 'Starting download...' }\n    }));\n    if (activeTab !== 'installed') {\n      handleTabChange('installed');\n    }\n  }"
