      "snippet": "handleBrowseWorkshop = async () => {\n    const path = await window.api.steam.selectWorkshopFolder();\n    if (path) {\n      setWorkshopPath(path);\n    }\n  }"
    },
    {
      "id": "usedayzmods_usedayzmods_handleimportworkshop",
      "label": "handleImportWorkshop()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzMods.ts",
      "source_location": "L206-L219",
