          "source_location": "L5"
        }
      ],
      "snippet": "export function useDayzMods(onNavigateToInstalled: () => void) {\n  const { activeServerId } = useServerStore();\n  const { addPendingDownload, removePendingDownload } = useDayzModStore();\n\n  const [searchQuery, setSearchQuery] = useState('');\n  const [activeCategory, setActiveCategory] = useState<number>(9);\n  const [results, setResults] = useState<any[]>([]);\n  const [page, setPage] = useState(1);\n  const [hasMore, setHasMore] = useState(true);\n  const [selectedTags, setSelectedTags] = useState<string[]>([]);\n  const [installedMods, setInstalledMods] = useState<any[]>([]);\n  const [workshopPath, setWorkshopPath] = useState<string>('');\n  const [isImporting, setIsImporting] = useState<boolean>(false);\n  const [loading, setLoading] = useState(false);\n  const loadMoreRef = useRef(null);\n  const [downloadProgress, setDownloadProgress] = useState<{ [id: string]: { percent: number, msg: string } }>({});\n  \n  const [steamCreds, setSteamCreds] = useState(() => {\n    try {\n      const saved = localStorage.getItem('omnihost_steam_creds');\n      return saved ? JSON.parse(atob(saved)) : { username: '', password: '', steamGuard: '' };\n    } catch {\n      return { username: '', password: '', steamGuard: '' };\n    }\n  });"
    },
    {
      "id": "usedayzmods_usedayzmods_loadinstalledmods",
      "label": "loadInstalledMods()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzMods.ts",
      "source_location": "L36-L42",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzMods.ts",
          "source_location": "L36"
        }
      ],
      "snippet": "loadInstalledMods = async () => {\n    if (!activeServerId) return;\n    const mods = await window.api.dayz.getInstalledMods(activeServerId);\n    if (mods) {\n      setInstalledMods(mods);\n    }\n  }"
    },
    {
      "id": "usedayzmods_usedayzmods_handlesearch",
      "label": "handleSearch()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzMods.ts",
      "source_location": "L44-L68",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzMods.ts",
          "source_location": "L44"
        }
      ],
      "snippet": "handleSearch = async (queryOverride?: string, categoryOverride?: number, pageOverride: number = 1, tagsOverride?: string[]) => {\n    const queryToUse = queryOverride !== undefined ? queryOverride : searchQuery;\n    const categoryToUse = categoryOverride !== undefined ? categoryOverride : activeCategory;\n    const tagsToUse = tagsOverride !== undefined ? tagsOverride : selectedTags;\n\n    if (pageOverride === 1) {\n      setResults([]);\n      setHasMore(true);\n    }\n\n    setLoading(true);\n    const res = await window.api.steam.searchWorkshop(queryToUse, categoryToUse, pageOverride, tagsToUse);\n\n    if (res && res.length > 0) {\n      if (pageOverride === 1) {\n        setResults(res);\n      } else {\n        setResults(prev => [...prev, ...res]);\n      }\n      setPage(pageOverride);\n    } else {\n      setHasMore(false);\n    }\n    setLoading(false);\n  }"
    },
    {
      "id": "usedayzmods_usedayzmods_handlecategorychange",
