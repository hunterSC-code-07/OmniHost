      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzMods.ts",
          "source_location": "L221"
        }
      ],
      "snippet": "stripBBCode = (text: string) => {\n    if (!text) return '';\n    return text\n      .replace(/\\[\\/?(b|i|u|s|url|img|quote|code|list|list=1|\\*|h1|h2|h3)\\]/g, '')\n      .replace(/\\[url=[^\\]]+\\]/g, '')\n      .replace(/\\[img\\][^\\[]+\\[\\/img\\]/g, '')\n      .trim();\n  }"
    }
  ],
