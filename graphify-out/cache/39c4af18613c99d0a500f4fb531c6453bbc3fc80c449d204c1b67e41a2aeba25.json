        }
      ],
      "snippet": "cleanup() {\n    if (this.logWatcher) {\n      clearInterval(this.logWatcher);\n      this.logWatcher = null;\n    }\n    if (this.logFd !== null) {\n      fs.closeSync(this.logFd);\n      this.logFd = null;\n    }\n  }"
    }
