    {
      "id": "dayzlogparser_dayzlogparser_pollforlogfile",
      "label": ".pollForLogFile()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/main/adapters/DayzLogParser.ts",
      "source_location": "L30-L53",
