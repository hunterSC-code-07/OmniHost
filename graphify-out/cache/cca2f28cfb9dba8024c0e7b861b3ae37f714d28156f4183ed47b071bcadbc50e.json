          "source_location": "L229"
        }
      ],
      "snippet": "handleUninstall = async (modId: string) => {\n    if (confirm('Are you sure you want to uninstall this mod?')) {\n      await window.api.uninstallDayzMod(activeServerId, modId);\n      await loadInstalledMods();\n    }\n  }"
    },
