          "source_location": "L100"
        }
      ],
      "snippet": "handleCategoryChange = (categoryId: number) => {\n    setActiveCategory(categoryId);\n    handleSearch(undefined, categoryId, 1, undefined);\n  }"
    },
    {
      "id": "dayzmodstab_dayzmodstab_handleinstall",
      "label": "handleInstall()",
      "file_type": "code",
      "source_file": "C:/OmniHostWIPDAYZ/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzModsTab.tsx",
      "source_location": "L125-L227",
