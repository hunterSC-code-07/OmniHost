      "snippet": "interface DayzModsTabProps {\n  activeServerId: number;\n  pendingDownloads?: Record<string, PendingDownload>;\n  addPendingDownload?: (mod: any) => void;\n  removePendingDownload?: (modId: string) => void;\n  updatePendingProgress?: (modId: string, progress: number, msg: string) => void;\n}"
    },
    {
      "id": "dayzmodstab_dayzmodstab",
      "label": "DayzModsTab()",
      "file_type": "code",
      "source_file": "C:/OmniHostWIPDAYZ/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzModsTab.tsx",
