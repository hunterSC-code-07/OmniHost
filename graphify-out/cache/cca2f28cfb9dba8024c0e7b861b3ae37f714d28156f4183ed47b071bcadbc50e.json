          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "C:/OmniHostWIPDAYZ/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzModsTab.tsx",
          "source_location": "L65"
        }
      ],
      "snippet": "loadInstalledMods = async () => {\n    // We would ask the main process for installed mods here.\n    // For now we'll just implement a basic version.\n    const mods = await window.api.getDayzInstalledMods(activeServerId);\n    if (mods) {\n      setInstalledMods(mods);\n    }\n  }"
    },
    {
      "id": "dayzmodstab_dayzmodstab_handlesearch",
      "label": "handleSearch()",
      "file_type": "code",
      "source_file": "C:/OmniHostWIPDAYZ/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzModsTab.tsx",
      "source_location": "L74-L98",
