      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "C:/OmniHostWIPDAYZ/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzModsTab.tsx",
          "source_location": "L74"
        }
      ],
      "snippet": "handleSearch = async (queryOverride?: string, categoryOverride?: number, pageOverride: number = 1, tagsOverride?: string[]) => {\n    const queryToUse = queryOverride !== undefined ? queryOverride : searchQuery;\n    const categoryToUse = categoryOverride !== undefined ? categoryOverride : activeCategory;\n    const tagsToUse = tagsOverride !== undefined ? tagsOverride : selectedTags;\n\n    if (pageOverride === 1) {\n      setResults([]);\n      setHasMore(true);\n    }\n\n    setLoading(true);\n    const res = await window.api.searchSteamWorkshop(queryToUse, categoryToUse, pageOverride, tagsToUse);\n\n    if (res && res.length > 0) {\n      if (pageOverride === 1) {\n        setResults(res);\n      } else {\n        setResults(prev => [...prev, ...res]);\n      }\n      setPage(pageOverride);\n    } else {\n      setHasMore(false);\n    }\n    setLoading(false);\n  }"
    },
    {
      "id": "dayzmodstab_dayzmodstab_handlecategorychange",
      "label": "handleCategoryChange()",
      "file_type": "code",
      "source_file": "C:/OmniHostWIPDAYZ/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzModsTab.tsx",
