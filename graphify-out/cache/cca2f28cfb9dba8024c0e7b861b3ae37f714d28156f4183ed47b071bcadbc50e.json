      "snippet": "handleBrowseWorkshop = async () => {\n    const path = await window.api.selectWorkshopFolder();\n    if (path) {\n      setWorkshopPath(path);\n    }\n  }"
    },
    {
      "id": "dayzmodstab_dayzmodstab_handleimportworkshop",
      "label": "handleImportWorkshop()",
      "file_type": "code",
      "source_file": "C:/OmniHostWIPDAYZ/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzModsTab.tsx",
      "source_location": "L243-L256",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "C:/OmniHostWIPDAYZ/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzModsTab.tsx",
          "source_location": "L243"
        }
      ],
      "snippet": "handleImportWorkshop = async () => {\n    if (!workshopPath) return;\n    setIsImporting(true);\n    try {\n      const count = await window.api.importLocalWorkshop(activeServerId, workshopPath);\n      alert(`Successfully imported ${count} mods from your !Workshop folder!\\n\\nNote: They have been marked as 'DISABLED' by default so your server doesn't crash on startup. Go to the 'Installed Mods' tab to enable the ones you want.`);\n      loadInstalledMods();\n    } catch (e: any) {\n      console.error(e);\n      alert('Failed to import local workshop mods: ' + e.message);\n    } finally {\n      setIsImporting(false);\n    }\n  }"
    },
