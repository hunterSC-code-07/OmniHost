      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "C:/OmniHostWIPDAYZ/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzModsTab.tsx",
          "source_location": "L13"
        }
      ],
      "snippet": "DayzModsTab: React.FC<DayzModsTabProps> = ({ \n  activeServerId,\n  pendingDownloads,\n  addPendingDownload,\n  removePendingDownload,\n  updatePendingProgress\n}) => {\n  const [searchQuery, setSearchQuery] = useState('');\n  const [activeCategory, setActiveCategory] = useState<number>(9);\n  const [results, setResults] = useState<any[]>([]);\n  const [page, setPage] = useState(1);\n  const [hasMore, setHasMore] = useState(true);\n  const [selectedTags, setSelectedTags] = useState<string[]>([]);\n  const [installedMods, setInstalledMods] = useState<any[]>([]);\n  const [workshopPath, setWorkshopPath] = useState<string>('');\n  const [isImporting, setIsImporting] = useState<boolean>(false);\n  const [loading, setLoading] = useState(false);\n  const loadMoreRef = React.useRef(null);\n  const [downloadProgress, setDownloadProgress] = useState<{ [id: string]: { percent: number, msg: string } }>({});\n  const [steamCreds, setSteamCreds] = useState(() => {\n    try {\n      const saved = localStorage.getItem('omnihost_steam_creds');\n      return saved ? JSON.parse(atob(saved)) : { username: '', password: '', steamGuard: '' };\n    } catch {\n      return { username: '', password: '', steamGuard: '' };",
      "node_kind": "component"
    },
    {
      "id": "dayzmodstab_dayzmodstab_loadinstalledmods",
      "label": "loadInstalledMods()",
      "file_type": "code",
      "source_file": "C:/OmniHostWIPDAYZ/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzModsTab.tsx",
      "source_location": "L65-L72",
      "layer": "base",
      "provenance": [
