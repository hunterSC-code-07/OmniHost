      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzFiles.ts",
          "source_location": "L105"
        }
      ],
      "snippet": "formatSize = (bytes: number) => {\n    if (bytes === 0) return '0 B';\n    const k = 1024;\n    const sizes = ['B', 'KB', 'MB', 'GB'];\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];\n  }"
    }
