        }
      ],
      "snippet": "handleNavigateUp = () => {\n    const parts = currentPath.split(/\\\\|\\//).filter(Boolean);\n    parts.pop();\n    fetchDir(parts.join('/'));\n  }"
    },
    {
      "id": "usedayzfiles_usedayzfiles_handlefileclick",
      "label": "handleFileClick()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzFiles.ts",
      "source_location": "L46-L65",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzFiles.ts",
          "source_location": "L46"
        }
      ],
      "snippet": "handleFileClick = async (file: FileEntry) => {\n    const fullPath = currentPath ? `${currentPath}/${file.name}` : file.name;\n    if (file.isDirectory) {\n      handleNavigate(fullPath);\n    } else {\n      const editableExts = ['.txt', '.json', '.cfg', '.xml', '.yaml', '.yml', '.log'];\n      const isEditable = editableExts.some(ext => file.name.toLowerCase().endsWith(ext));\n      \n      if (isEditable || file.size < 1024 * 1024) {\n        try {\n          const content = await window.api.fs.readFile(activeServerId, fullPath);\n          setEditingFile({ path: fullPath, content });\n        } catch (e) {\n          alert('Could not read file');\n        }\n      } else {\n        alert('File type not supported for editing or too large.');\n      }\n    }\n  }"
    },
    {
      "id": "usedayzfiles_usedayzfiles_handledelete",
      "label": "handleDelete()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzFiles.ts",
      "source_location": "L67-L78",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzFiles.ts",
          "source_location": "L67"
        }
      ],
      "snippet": "handleDelete = async (e: React.MouseEvent, file: FileEntry) => {\n    e.stopPropagation();\n    if (!confirm(`Are you sure you want to delete ${file.name}?`)) return;\n    \n    const fullPath = currentPath ? `${currentPath}/${file.name}` : file.name;\n    try {\n      await window.api.fs.deleteItem(activeServerId, fullPath);\n      fetchDir(currentPath);\n    } catch (e) {\n      alert('Failed to delete item');\n    }\n  }"
    },
    {
      "id": "usedayzfiles_usedayzfiles_handlesavefile",
      "label": "handleSaveFile()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzFiles.ts",
      "source_location": "L80-L89",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzFiles.ts",
          "source_location": "L80"
        }
      ],
      "snippet": "handleSaveFile = async () => {\n    if (!editingFile) return;\n    try {\n      await window.api.fs.writeFile(activeServerId, editingFile.path, editingFile.content);\n      alert('File saved successfully!');\n      setEditingFile(null);\n    } catch (e) {\n      alert('Failed to save file');\n    }\n  }"
    },
    {
      "id": "usedayzfiles_usedayzfiles_handlecreatefolder",
      "label": "handleCreateFolder()",
