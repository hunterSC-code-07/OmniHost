    {
      "id": "usedayzfiles_usedayzfiles",
      "label": "useDayzFiles()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzFiles.ts",
      "source_location": "L11-L129",
