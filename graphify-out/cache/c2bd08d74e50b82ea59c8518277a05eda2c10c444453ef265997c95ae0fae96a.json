        }
      ],
      "snippet": "export function useDayzEconomy() {\n  const { activeServerId } = useServerStore();\n  const [isLoading, setIsLoading] = useState(true);\n  const [isSaving, setIsSaving] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  // Economy State\n  const [pristineLoot, setPristineLoot] = useState(false);\n  \n  // Default multipliers are 1\n  const [multipliers, setMultipliers] = useState<Record<string, number>>({\n    food: 1.0,\n    weapons: 1.0,\n    clothes: 1.0,\n    tools: 1.0,\n    vehiclesparts: 1.0,\n  });\n\n  useEffect(() => {\n    loadEconomy();\n  }, [activeServerId]);\n\n  const loadEconomy = async () => {\n    if (!activeServerId) return;\n    setIsLoading(true);"
    },
    {
      "id": "usedayzeconomy_usedayzeconomy_loadeconomy",
      "label": "loadEconomy()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzEconomy.ts",
      "source_location": "L26-L43",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzEconomy.ts",
          "source_location": "L26"
        }
      ],
      "snippet": "loadEconomy = async () => {\n    if (!activeServerId) return;\n    setIsLoading(true);\n    setError(null);\n    try {\n      const data = await (window.api as any).getDayzEconomy(activeServerId);\n      if (data) {\n        setPristineLoot(data.pristineLoot);\n      } else {\n        setError('Could not read economy files. Make sure the server has been started at least once so the mission files exist.');\n      }\n    } catch (e) {\n      console.error(\"Failed to load DayZ economy\", e);\n      setError('An error occurred while reading economy files.');\n    } finally {\n      setIsLoading(false);\n    }\n  }"
    },
    {
      "id": "usedayzeconomy_usedayzeconomy_handlemultiplierchange",
      "label": "handleMultiplierChange()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzEconomy.ts",
      "source_location": "L45-L50",
