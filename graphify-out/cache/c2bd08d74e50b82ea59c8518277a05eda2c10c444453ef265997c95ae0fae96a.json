      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzEconomy.ts",
          "source_location": "L45"
        }
      ],
      "snippet": "handleMultiplierChange = (category: string, value: number) => {\n    setMultipliers(prev => ({\n      ...prev,\n      [category]: value\n    }));\n  }"
    },
    {
      "id": "usedayzeconomy_usedayzeconomy_handlesave",
      "label": "handleSave()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzEconomy.ts",
      "source_location": "L52-L72",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/hooks/useDayzEconomy.ts",
          "source_location": "L52"
        }
      ],
      "snippet": "handleSave = async () => {\n    setIsSaving(true);\n    try {\n      const settings = {\n        pristineLoot,\n        multipliers\n      };\n      \n      const success = await (window.api as any).updateDayzEconomy(activeServerId, settings);\n      if (success) {\n        alert('Economy settings updated successfully! Original XML files were backed up.');\n      } else {\n        alert('Failed to update economy settings. Mission files might be missing.');\n      }\n    } catch (e) {\n      console.error(\"Failed to save DayZ economy\", e);\n      alert('An error occurred while saving.');\n    } finally {\n      setIsSaving(false);\n    }\n  }"
    }
  ],
