      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzFilesTab.tsx",
          "source_location": "L94"
        }
      ],
      "snippet": "handleCreateFolder = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newFolderName) return;\n    \n    const fullPath = currentPath ? `${currentPath}/${newFolderName}` : newFolderName;\n    try {\n      await window.api.createFolder(activeServerId, fullPath);\n      setNewFolderName(null);\n      fetchDir(currentPath);\n    } catch (e) {\n      alert('Failed to create folder');\n    }\n  }"
    },
    {
      "id": "dayzfilestab_dayzfilestab_formatsize",
      "label": "formatSize()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzFilesTab.tsx",
      "source_location": "L108-L114",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/tabs/DayzFilesTab.tsx",
          "source_location": "L108"
        }
      ],
      "snippet": "formatSize = (bytes: number) => {\n    if (bytes === 0) return '0 B';\n    const k = 1024;\n    const sizes = ['B', 'KB', 'MB', 'GB'];\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];\n  }"
    }
  ],
