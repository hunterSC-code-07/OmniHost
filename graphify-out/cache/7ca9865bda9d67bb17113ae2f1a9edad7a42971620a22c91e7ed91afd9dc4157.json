        }
      ],
      "snippet": "function scan(buf, patternStr) {\n    const pattern = patternStr.split(' ').map(p => p === '?' ? -1 : parseInt(p, 16));\n    for (let i = 0; i < buf.length - pattern.length; i++) {\n        let match = true;\n        for (let j = 0; j < pattern.length; j++) {\n            if (pattern[j] !== -1 && buf[i + j] !== pattern[j]) {\n                match = false;\n                break;\n            }\n        }\n        if (match) return i;\n    }\n    return -1;\n}"
    }
  ],
