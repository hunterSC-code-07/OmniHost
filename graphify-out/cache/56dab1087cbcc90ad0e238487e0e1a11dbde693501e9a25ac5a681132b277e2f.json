      "snippet": "static sendLog(serverId: number, progress: number, msg: string) {\n    const windows = BrowserWindow.getAllWindows();\n    if (windows.length > 0) {\n      windows[0].webContents.send(`download-progress-${serverId}`, progress, msg);\n    }\n  }"
    }
