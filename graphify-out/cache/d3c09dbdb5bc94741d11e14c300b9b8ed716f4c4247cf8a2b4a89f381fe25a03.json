DayzFileOperations.ts","source_location":"L9-L20","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzFileOperations.ts","source_location":"L9"}],"snippet":"handleDelete = async (e: React.MouseEvent, file: FileEntry) => {\n    e.stopPropagation();\n    if (!confirm(`Are you sure you want to delete ${file.name}?`)) return;\n    \n    const fullPath = currentPath ? `${currentPath}/${file.name}` : file.name;\n    try {\n      await window.api.fs.deleteItem(activeServerId, fullPath);\n      fetchDir(currentPath);\n    } catch (e) {\n      alert('Failed to delete item');\n    }\n  }"},{"id":"usedayzfileoperations_usedayzfileoperations_handlecreatefolder","label":"handleCreateFolder()","file_type":"code","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzFileOperations.ts","source_location":"L22-L34","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzFileOperations.ts","source_location":"L22"}],"snippet":"handleCreateFolder = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newFolderName) return;\n    \n    const fullPath = currentPath ? `${currentPath}/${newFolderName}` : newFolderName;\n    try {\n      await window.api.fs.createFolder(activeServerId, fullPath);\n      setNewFolderName(null);\n      fetchDir(currentPath);\n    } catch (e) {\n      alert('Failed to create folder');\n    }\n  }"}],"edges":[{"source":"usedayzfileoperations","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzFileOperations.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/renderer/src/hooks/useDayzFileOperations.ts","source_location":"L1"}],"weight":1},{"source":"used