{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"minecraftprocessmanager","label":"MinecraftProcessManager.ts","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L1"}]},{"id":"minecraftprocessmanager_minecraftprocessmanager","label":"MinecraftProcessManager","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L10-L266","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L10"}],"snippet":"export class MinecraftProcessManager {\n  serverId: number;\n  serverDir: string;\n  process: ChildProcess | null = null;\n  playerManager: MinecraftPlayerManager;\n  autoStopTimer: NodeJS.Timeout | null = null;\n  statsTimer: NodeJS.Timeout | null = null;\n  omnihostMeta: any = {}; \n  javaPid: number | null = null; \n  isFullyStarted: boolean = false; \n  logHistory: string[] = [];\n  logBuffer: string[] = [];\n  logFlushTimer: NodeJS.Timeout | null = null;\n\n  constructor(serverId: number) {\n    this.serverId = serverId;\n    this.serverDir = join(app.getPath('userData'), 'servers', serverId.toString());\n    this.playerManager = new MinecraftPlayerManager(serverId, this.serverDir);\n  }\n\n  sendLog(msg: string) {\n    console.log(msg); // Guaranteed VS Code output!\n    this.logHistory.push(msg);\n    if (this.logHistory.length > 2000) this.logHistory.shift();"},{"id":"minecraftprocessmanager_minecraftprocessmanager_constructor","label":".constructor()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L24-L28","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L24"}],"snippet":"constructor(serverId: number) {\n    this.serverId = serverId;\n    this.serverDir = join(app.getPath('userData'), 'servers', serverId.toString());\n    this.playerManager = new MinecraftPlayerManager(serverId, this.serverDir);\n  }"},{"id":"minecraftprocessmanager_minecraftprocessmanager_sendlog","label":".sendLog()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L30-L49","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L30"}],"snippet":"sendLog(msg: string) {\n    console.log(msg); // Guaranteed VS Code output!\n    this.logHistory.push(msg);\n    if (this.logHistory.length > 2000) this.logHistory.shift();\n    \n    this.logBuffer.push(msg);\n    if (!this.logFlushTimer) {\n      this.logFlushTimer = setTimeout(() => {\n        const msgs = [...this.logBuffer];\n        this.logBuffer = [];\n        this.logFlushTimer = null;\n        if (msgs.length > 0) {\n          const batchedMsg = msgs.join('\\n');\n          BrowserWindow.getAllWindows().forEach(win => {\n            if (!win.isDestroyed()) win.webContents.send('console-log', { id: this.serverId, msg: batchedMsg });\n          });\n        }\n      }, 50);\n    }\n  }"},{"id":"minecraftprocessmanager_minecraftprocessmanager_sendcommand","label":".sendCommand()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L51-L58","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L51"}],"snippet":"sendCommand(cmd: string) {\n    if (this.process && this.process.stdin) {\n      this.process.stdin.write(cmd + '\\n');\n      this.sendLog(`> ${cmd}`); \n    } else {\n      this.sendLog(`[System] Cannot send command: Server is offline.`);\n    }\n  }"},{"id":"minecraftprocessmanager_minecraftprocessmanager_getactualpid","label":".getActualPid()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L60-L114","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L60"}],"snippet":"private getActualPid(): Promise<number> {\n    return new Promise((resolve) => {\n      const proc = this.process;\n      if (!proc || !proc.pid) return resolve(0);\n      if (this.javaPid) return resolve(this.javaPid);\n      if (process.platform !== 'win32') return resolve(proc.pid);\n\n      const { spawn } = require('child_process');\n      const ps = spawn('powershell', ['-NoProfile', '-Command', '-']);\n      \n      let out = '';\n      ps.stdout.on('data', (data: any) => out += data.toString());\n      \n      ps.on('close', () => {\n        const pid = parseInt(out.trim());\n        if (!isNaN(pid) && pid > 0) {\n          this.javaPid = pid;\n          resolve(pid);\n        } else {\n          resolve(proc.pid!);\n        }\n      });\n\n      const script = `\n        $all = Get-CimInstance Win32_Process | Select-Object ProcessId, ParentProcessId, Name"},{"id":"minecraftprocessmanager_minecraftprocessmanager_start","label":".start()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L118-L209","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L118"}],"snippet":"async start() {\n    await MinecraftConfigManager.init(this.serverDir);\n    this.playerManager.clearOnlinePlayers(); \n    this.logHistory = [];\n    this.isFullyStarted = false;\n    this.playerManager.sendPlayerUpdate();\n    \n    this.sendLog(`[System] Starting Server ${this.serverId}...`);\n\n    const metaPath = join(this.serverDir, 'omnihost.json');\n    if (fs.existsSync(metaPath)) {\n      try {\n        this.omnihostMeta = JSON.parse(fs.readFileSync(metaPath, 'utf-8'));\n      } catch (e) {}\n    }\n\n    const command = await MinecraftCommandBuilder.buildCommand(this.serverDir, (msg) => this.sendLog(msg));\n    if (!command) return;\n\n    const { targetExecutable, targetArgs, env } = command;\n\n    this.sendLog(`[System] Launching Java with args: ${targetArgs.join(' ')}`);\n    this.process = spawn(targetExecutable, targetArgs, { cwd: this.serverDir, env });\n    this.javaPid = null;"},{"id":"minecraftprocessmanager_minecraftprocessmanager_stop","label":".stop()","file_type":"code","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L211-L265","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L211"}],"snippet":"async stop(): Promise<void> {\n    return new Promise(async (resolve) => {\n      if (!this.process) {\n        resolve();\n        return;\n      }\n      \n      this.sendLog(`[System] Stopping Server ${this.serverId}...`);\n      this.process.stdin?.write('stop\\n');\n      \n      const p = this.process;\n      this.process = null;\n      if (this.autoStopTimer) clearTimeout(this.autoStopTimer);\n      if (this.statsTimer) clearInterval(this.statsTimer);\n      this.autoStopTimer = null;\n      this.statsTimer = null;\n\n      // Update stats for all players before clearing them\n      await this.playerManager.handleServerStop();\n\n      let isResolved = false;\n\n      p.on('exit', () => {\n         if (!isResolved) {\n             isResolved = true;"}],"edges":[{"source":"minecraftprocessmanager","target":"child_process","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L1"}],"weight":1},{"source":"minecraftprocessmanager","target":"path","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L2","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L2"}],"weight":1},{"source":"minecraftprocessmanager","target":"electron","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L3"}],"weight":1},{"source":"minecraftprocessmanager","target":"fs","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L4","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L4"}],"weight":1},{"source":"minecraftprocessmanager","target":"minecraftcommandbuilder","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/github/OmniHost/src/main/minecraft/MinecraftProcessManager.ts","source_location":"L5","layer":"b