      ],
      "snippet": "interface DayzHubProps {\n  activeServerId: number;\n  activeServer: any;\n  setActiveServerId: React.Dispatch<React.SetStateAction<number | null>>;\n  handleStart: (id: number) => void;\n  handleStop: (id: number) => void;\n  handleRestart: (id: number) => void;\n  handleDelete: (id: number) => void;\n  handleTunnel: () => void;\n  radminIp: string | null;\n  logs: any[];\n  setLogs: React.Dispatch<React.SetStateAction<any[]>>;\n  onlinePlayers: Record<string, string[]>;\n  statsHistory: Record<string, { cpu: number, ram: number }[]>;\n}"
    },
    {
      "id": "dayzhub_dayzhub",
      "label": "DayzHub()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/DayzHub.tsx",
      "source_location": "L35-L302",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/DayzHub.tsx",
          "source_location": "L35"
        }
      ],
      "snippet": "DayzHub: React.FC<DayzHubProps> = ({\n  activeServerId,\n  activeServer,\n  setActiveServerId,\n  handleStart,\n  handleStop,\n  handleRestart,\n  handleDelete,\n  handleTunnel,\n  radminIp,\n  logs,\n  setLogs,\n  onlinePlayers,\n  statsHistory,\n}) => {\n  const [activeTab, setActiveTab] = useState<'console' | 'options' | 'economy' | 'mods' | 'installed' | 'files'>('console');\n  const [tabDirection, setTabDirection] = useState(0);\n  const [isTabTransitioning, setIsTabTransitioning] = useState(false);\n  const handleTabChange = (newTab: typeof activeTab) => {\n    if (newTab === activeTab) return;\n    const TABS = ['console', 'options', 'economy', 'mods', 'installed', 'files'];\n    const currentIndex = TABS.indexOf(activeTab);\n    const newIndex = TABS.indexOf(newTab);\n    setTabDirection(newIndex > currentIndex ? 1 : -1);\n    setIsTabTransitioning(true);",
      "node_kind": "component"
    },
    {
      "id": "dayzhub_dayzhub_handletabchange",
      "label": "handleTabChange()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/DayzHub.tsx",
      "source_location": "L53-L62",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/DayzHub.tsx",
          "source_location": "L53"
        }
      ],
      "snippet": "handleTabChange = (newTab: typeof activeTab) => {\n    if (newTab === activeTab) return;\n    const TABS = ['console', 'options', 'economy', 'mods', 'installed', 'files'];\n    const currentIndex = TABS.indexOf(activeTab);\n    const newIndex = TABS.indexOf(newTab);\n    setTabDirection(newIndex > currentIndex ? 1 : -1);\n    setIsTabTransitioning(true);\n    setActiveTab(newTab);\n    setTimeout(() => setIsTabTransitioning(false), 350);\n  }"
    },
    {
      "id": "dayzhub_dayzhub_addpendingdownload",
      "label": "addPendingDownload()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/DayzHub.tsx",
      "source_location": "L78-L86",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/DayzHub.tsx",
          "source_location": "L78"
        }
      ],
      "snippet": "addPendingDownload = (mod: any) => {\n    setPendingDownloads(prev => ({\n      ...prev,\n      [mod.id || mod.publishedfileid]: { ...mod, progress: 0, msg: 'Starting download...' }\n    }));\n    if (activeTab !== 'installed') {\n      handleTabChange('installed');\n    }\n  }"
    },
    {
      "id": "dayzhub_dayzhub_removependingdownload",
      "label": "removePendingDownload()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/DayzHub.tsx",
      "source_location": "L88-L94",
      "layer": "base",
