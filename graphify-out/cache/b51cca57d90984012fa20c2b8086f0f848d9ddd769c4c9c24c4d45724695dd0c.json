        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/DayzHub.tsx",
          "source_location": "L88"
        }
      ],
      "snippet": "removePendingDownload = (modId: string) => {\n    setPendingDownloads(prev => {\n      const next = { ...prev };\n      delete next[modId];\n      return next;\n    });\n  }"
    },
    {
      "id": "dayzhub_dayzhub_updatependingprogress",
      "label": "updatePendingProgress()",
      "file_type": "code",
      "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/DayzHub.tsx",
      "source_location": "L96-L104",
      "layer": "base",
      "provenance": [
        {
          "capability_id": "builtin:extract:typescript",
          "stage": "extract",
          "source_file": "D:/github/OmniHost/src/renderer/src/components/hubs/DayzHub/DayzHub.tsx",
          "source_location": "L96"
        }
      ],
      "snippet": "updatePendingProgress = (modId: string, progress: number, msg: string) => {\n    setPendingDownloads(prev => {\n      if (!prev[modId]) return prev;\n      return {\n        ...prev,\n        [modId]: { ...prev[modId], progress, msg }\n      };\n    });\n  }"
    },
